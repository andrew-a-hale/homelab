# /etc/systemd/system/petcam.service on Ralph.
[Unit]
Description=Pet Cam gallery UI (detections, training labels; HLS proxied from Tom)
After=network-online.target
Wants=network-online.target

[Service]
User=andy
# Loopback only: Ralph's nginx is the single way in (the Cloudflare tunnel's
# origin). The state it serves is ~/petcam on this box.
# PORT=8082, not 8080: the website app (andrewhale-web) already owns 8080 here.
Environment=BIND=127.0.0.1
Environment=PORT=8082
ExecStart=/home/andy/projects/homelab/petcam/petcam
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
