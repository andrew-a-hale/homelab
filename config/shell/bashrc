# Prompt: starship, config in ~/.config/starship.toml
eval "$(starship init bash)"

# History: no duplicates, shared between windows, large
shopt -s histappend checkwinsize
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoredups:erasedups

# Basics
