# streamlink -> mpv with Twitch chat overlay (mpv-twitch-chat-irc)
sl() {
  local url="${1:?usage: sl <channel|url>}"
  if [[ "$url" != *"twitch.tv"* && "$url" != *"://"* ]]; then
    url="https://www.twitch.tv/$url"
  fi
  local chan="${url#*twitch.tv/}"
  chan="${chan%%[/?#]*}"
  streamlink --player mpv \
    --player-args "--profile=twitch --script-opts=twitch-chat-channel=$chan" \
    "$url"
}
