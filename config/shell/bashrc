command -v go >/dev/null && export PATH="$PATH:$(go env GOPATH)/bin"
export PATH='/home/andy/.duckdb/cli/latest':$PATH
export PATH='/home/andy/.dotnet':$PATH
export GPG_TTY=$(tty)
export TERM=ghostty

