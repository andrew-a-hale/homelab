// waybar — workspace indicator, clock + date, wifi, volume. Nothing else:
// docs/jason/needs.md batch 5 cut the tray, the OSD, panels and the menus.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 10,
  "margin-top": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio"],

  // Show the workspaces that exist, not a fixed row. Omarchy's 10-per-monitor
  // scheme (DP-1 owned 11-20) went with Omarchy; waybar's
  // "persistent-workspaces" is not usable here — {"DP-2": 10} produced
  // workspaces 21-30, and {"*": 10} creates nothing (measured on 0.15.0). Windows that
  // were stranded on 11/14 have been moved back. Only 1-6 can be created:
  // SUPER + 7/8/9/0 are unbound in config/hypr/binds.lua.
  // Every bar lists all of them ("all-outputs": true), and the blue chip on a
  // bar is the workspace that bar's own monitor displays — `.visible` plus
  // `.hosting-monitor` in style.css, because `.active` alone lights the same
  // number on both bars.
  // No on-click option exists: clicking a number is built in and sends
  // Hyprland a dispatch. That needs waybar >= 0.16.0 (0.15.0 sends the legacy
  // "dispatch workspace N", which a Lua-config Hyprland rejects; 0.16.0 reads
  // configProvider from systeminfo and sends hl.dsp.focus instead).
  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by": "number",
    "all-outputs": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><span color='#7aa2f7'>{}</span></b>"
      }
    }
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ifname}",
    "format-disconnected": " offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "ghostty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": ["", "", ""],
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  }
}
